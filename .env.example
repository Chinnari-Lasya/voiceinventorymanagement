# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
# All of these are server-side only. Never prefix a secret with NEXT_PUBLIC_.

# Path to the SQLite file (created on first run). Use ":memory:" only for tests.
DATABASE_PATH=./data/stockbol.db

# Signs session cookies. Required (>= 32 chars) in production; a dev-only default is used otherwise.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Anthropic API key for voice understanding (needed from M4). Leave empty to run in Basic mode.
ANTHROPIC_API_KEY=

# Model used for interpretation (default: claude-haiku-4-5-20251001).
LLM_MODEL=claude-haiku-4-5-20251001

# 1 enables demo mode helpers (used from M7). Default 0.
DEMO_MODE=0
